{
  "name": "asqac-capsule-care-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:prepare": "node --env-file=.env scripts/prepare-frontend-deploy.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:edge": "tsc --noEmit --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions --strict --skipLibCheck tests/deno-globals.d.ts supabase/functions/telemetry/index.ts supabase/functions/maintenance/index.ts",
    "check:firmware": "node --import tsx scripts/check-circuit-firmware.ts",
    "build:firmware": "node scripts/build-circuit-firmware.mjs",
    "measure:latency": "node --env-file=.env scripts/measure-device-latency.mjs",
    "verify:batch": "node --env-file=.env scripts/verify-batch-live.mjs",
    "verify:barometry": "node --env-file=.env scripts/verify-batch-live.mjs --barometry",
    "test:browser": "node scripts/browser-tests.mjs",
    "sql:bundle": "node scripts/build-supabase-sql.mjs",
    "verify:supabase": "node --env-file=.env scripts/probe-supabase.mjs",
    "verify:live": "node --env-file=.env scripts/verify-live.mjs",
    "check:client-secrets": "node --env-file=.env scripts/check-client-bundle.mjs",
    "verify:browser": "node --env-file=.env scripts/verify-browser-live.mjs",
    "format": "prettier --write src scripts tests *.json *.ts *.js *.html README.md supabase/functions/**/*.ts",
    "simulator": "node --env-file=.env scripts/simulator.mjs",
    "create-users": "node --env-file=.env scripts/create-demo-users.mjs",
    "device-token": "node --env-file=.env scripts/register-device.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.49.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "three": "^0.172.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
